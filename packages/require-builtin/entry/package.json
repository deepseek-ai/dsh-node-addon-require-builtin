{
  "name": "node-addon-require-builtin",
  "version": "0.1.1",
  "type": "commonjs",
  "description": "Node-API addon with runtime probing for internal access (unrestricted require-builtin variant).",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "lib/",
    "!lib/.tsbuildinfo",
    "!lib/*.tsbuildinfo"
  ],
  "scripts": {
    "build:js": "tsc -b"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "node-addon-native-custom-loader": "workspace:*"
  },
  "optionalDependencies": {
    "node-addon-require-builtin-darwin-arm64": "workspace:*",
    "node-addon-require-builtin-darwin-x64": "workspace:*",
    "node-addon-require-builtin-linux-arm64-gnu": "workspace:*",
    "node-addon-require-builtin-linux-x64-gnu": "workspace:*",
    "node-addon-require-builtin-win32-arm64-msvc": "workspace:*",
    "node-addon-require-builtin-win32-ia32-msvc": "workspace:*",
    "node-addon-require-builtin-win32-x64-msvc": "workspace:*"
  }
}
