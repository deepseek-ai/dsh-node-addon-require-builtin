{
  "name": "@esplus/node-addon-native-custom-loader",
  "version": "0.0.10",
  "type": "commonjs",
  "description": "Shared native binary loader for the @esplus/node-addon-require-builtin and @esplus/node-addon-internal-loader package families.",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "README.md",
    "lib/",
    "!lib/.tsbuildinfo",
    "!lib/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:js": "tsc -b"
  },
  "license": "MIT"
}
